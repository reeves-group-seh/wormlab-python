{
  "#ascii_art": {
    "font": {
      "name": "fira_code_symbols",
      "size": "14"
    },
    "misc": {
      "line_spacing": "0.9",
      "text_horiz_alignment": "center",
      "text_vert_alignment": "center",
      "border_width": "1",
      "shadow_width": "0"
    }
  },

  "#panel_heading_panel": {
    "colours": {
      "dark_bg": "#27272A"
    },
    "misc": {
      "border_width": "0",
      "shadow_width": "0"
    }
  },
  "#panel_heading_label": {
    "font": {
      "name": "noto_sans",
      "size": "12",
      "bold": "1"
    }
  },

  "#comment_input_box": {
    "misc": {
      "padding": "4,3"
    }
  },

  "@axonkit_background": {
    "colours": {
      "dark_bg": "#3A0025"
    }
  },

  "#status_bar_panel": {
    "colours": {
      "dark_bg": "#571C3D"
    }
  },
  "#status_bar_text": {
    "font": {
      "name": "noto_sans",
      "size": "12"
    },
    "misc": {
      "text_vert_alignment": "center"
    }
  },
  "#status_bar_text_right": {
    "prototype": "#axonkit_demo_layout_bar_text",
    "misc": {
      "text_horiz_alignment": "right"
    }
  },

  "@laser_unlocked": {
    "prototype": "@axonkit_panel",
    "colours": {
      "dark_bg": "#00FF00"
    }
  },
  "@laser_flashing": {
    "prototype": "@axonkit_panel",
    "colours": {
      "dark_bg": "#0000FF"
    }
  },
  "@laser_locked": {
    "prototype": "@axonkit_panel",
    "colours": {
      "dark_bg": "#FF0000"
    }
  },
  "#laser_phase_label": {
    "font": {
      "name": "noto_sans",
      "size": "16",
      "bold": "1"
    },
    "misc": {
      "text_horiz_alignment": "center"
    }
  },
  "#laser_countdown_label": {
    "font": {
      "name": "noto_sans",
      "size": "14"
    },
    "misc": {
      "text_horiz_alignment": "center"
    }
  },
  "#laser_data_needed_label": {
    "font": {
      "name": "noto_sans",
      "size": "14"
    },
    "misc": {
      "text_horiz_alignment": "center"
    }
  }
}
